groq_api_key
adzuna_app_id
adzuna_api_key
google_resume_doc_id
service_account_file
# google_service_account_json: for deployed hosts with no filesystem access —
# paste the service-account JSON content itself; takes precedence over service_account_file
google_service_account_json
sender_email
gmail_app_password
recipient_email
# default_role: ml_ai_engineer | data_science | backend_swe
default_role
# groq_model: any Groq-hosted chat model id; default moonshotai/kimi-k2
groq_model
jobs_per_run
# score_threshold: 0-10 scoring gate default (jobs below it are skipped, not rewritten)
score_threshold
# role_resume_doc_ids: optional per-role resume profiles as JSON; unset roles fall back to google_resume_doc_id
# e.g. ROLE_RESUME_DOC_IDS={"data_science": "<doc-id>"}
role_resume_doc_ids
# turso_database_url + turso_auth_token: hosted dedup DB for deployed instances
# (free-tier filesystems are ephemeral). Unset -> local sqlite file.
turso_database_url
turso_auth_token
# run_token: when set, POST /run requires a matching X-API-Key header
run_token
# resend_api_key: when set, digest is sent via the Resend HTTPS API instead of
# Gmail SMTP (required on Render free tier, which blocks outbound SMTP)
resend_api_key
# resend_from: optional sender override, defaults to Resend's onboarding sender
resend_from